# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Comma-separated origins. Use the deployed admin origin(s) in production.
CORS_ORIGINS=http://localhost:3000

# Firebase Admin credentials (Render secret environment variables)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# Keep the literal \\n sequences when pasting this value into Render.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com

# Current single-campus identifier. Persisted records are scoped to this campus.
CAMPUS_ID=main

# Dispatch policy
ASSIGNMENT_TTL_SECONDS=30
DISPATCH_LOCATION_FRESHNESS_SECONDS=30
DISPATCH_MAX_LOCATION_ACCURACY_METERS=100

# OpenRouteService-compatible provider. The key stays on Render, never in Flutter.
ROUTING_PROVIDER_URL=https://api.openrouteservice.org
ROUTING_PROVIDER_API_KEY=replace-with-a-render-secret
ROUTING_TIMEOUT_MS=5000
ROUTING_ORIGIN_TOLERANCE_METERS=75
ROUTING_DESTINATION_TOLERANCE_METERS=30
LOCATION_ACCESS_TTL_SECONDS=7200
WORKER_POLL_INTERVAL_MS=5000
